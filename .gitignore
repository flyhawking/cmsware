# 含敏感信息的本地配置
config.php

# 运行时生成的文件（保留目录骨架）
sysdata/logs/
sysdata/cache/*
!sysdata/cache/.htaccess
!sysdata/cache/index.html
sysdata/templates_c/*
!sysdata/templates_c/.htaccess
sysdata/automini/*
!sysdata/automini/.htaccess
sysdata/sysinfo/*
!sysdata/sysinfo/.htaccess
sysdata/tmp/*
!sysdata/tmp/.htaccess
sysdata/sess_*
sysdata/install.lock
sysdata/*.log.php

# 上传的资源文件（保留目录骨架）
resource/img/*
!resource/img/index.html
resource/attach/*
!resource/attach/index.html
resource/flash/*
!resource/flash/index.html

# 发布输出
publish/tmp/*
!publish/tmp/.htaccess

# 系统文件
.DS_Store
Thumbs.db
*.bak
*.bak.php
